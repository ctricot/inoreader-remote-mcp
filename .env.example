# Copy to `.env` next to docker-compose.yml, fill in, `chmod 600 .env`.

# The public HTTPS address of this server, as Claude reaches it (no trailing slash).
# It is the OAuth issuer and the base of the Inoreader redirect URI.
PUBLIC_URL=https://inoreader.example.com

# From your Inoreader app (Preferences → Developer). Its redirect URI must be
# ${PUBLIC_URL}/oauth/inoreader/callback, and its scope "Read and write".
INOREADER_APP_ID=
INOREADER_APP_KEY=

# Protects the Inoreader authorisation and the Claude consent screen. Use a long random
# value, e.g. `head -c 32 /dev/urandom | base64`.
ADMIN_PASSWORD=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
